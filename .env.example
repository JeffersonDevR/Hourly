# Hourly — variables de entorno.
# Copia este archivo a `.env` y ajusta. Sin secretos reales en el repo.

# Base de datos SQLite en un archivo (D-001). Cambiar esta URL es todo lo que
# hace falta para volver a Postgres en el futuro.
DATABASE_URL=sqlite:///./hourly.db

# Asistente IA: API compatible con OpenAI (/v1/chat/completions, D-002).
# AI_BASE_URL=http://localhost:11434/v1  -> Ollama local, demo 100% offline.
# Dejar vacio = NullProvider: la app funciona y ai_disponible=false.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Timeout del solver CP-SAT en segundos (ARCHITECTURE.md).
SOLVER_TIMEOUT_S=20
